<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/slot_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="3dp"
        android:background="@drawable/slot_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/art_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_art"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <ImageView
                android:id="@+id/app_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_bg"
                android:padding="2dp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artist"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_prev"
            android:padding="9dp"
            android:src="@drawable/ic_prev"
            android:tint="@color/icon" />

        <ImageView
            android:id="@+id/btn_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/play_bg"
            android:contentDescription="@string/cd_play"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            android:tint="@color/play_icon" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_next"
            android:padding="9dp"
            android:src="@drawable/ic_next"
            android:tint="@color/icon" />
    </LinearLayout>
