<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="3dp"
        android:background="@drawable/slot_active_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">
        <FrameLayout
            
            android:layout_width="56dp"
            android:layout_height="56dp">
            <ImageView
                
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/art_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_art"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />
            <ImageView
                
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_bg"
                android:padding="2dp"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Morning Mix"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Music"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_prev"
            android:padding="9dp"
            android:src="@drawable/ic_prev"
            android:tint="@color/icon" />
        <ImageView
            
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/play_bg"
            android:contentDescription="@string/cd_play"
            android:padding="10dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/play_icon" />
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_next"
            android:padding="9dp"
            android:src="@drawable/ic_next"
            android:tint="@color/icon" />
    </LinearLayout>
    <LinearLayout
        
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="3dp"
        android:background="@drawable/slot_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">
        <FrameLayout
            
            android:layout_width="56dp"
            android:layout_height="56dp">
            <ImageView
                
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/art_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_art"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />
            <ImageView
                
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_bg"
                android:padding="2dp"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chapter 12"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Audiobook · paused"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_prev"
            android:padding="9dp"
            android:src="@drawable/ic_prev"
            android:tint="@color/icon" />
        <ImageView
            
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/play_bg"
            android:contentDescription="@string/cd_play"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            android:tint="@color/play_icon" />
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_next"
            android:padding="9dp"
            android:src="@drawable/ic_next"
            android:tint="@color/icon" />
    </LinearLayout>
    <LinearLayout
        
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="3dp"
        android:background="@drawable/slot_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">
        <FrameLayout
            
            android:layout_width="56dp"
            android:layout_height="56dp">
            <ImageView
                
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/art_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_art"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />
            <ImageView
                
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_bg"
                android:padding="2dp"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Episode 42"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Podcast · paused"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_prev"
            android:padding="9dp"
            android:src="@drawable/ic_prev"
            android:tint="@color/icon" />
        <ImageView
            
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/play_bg"
            android:contentDescription="@string/cd_play"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            android:tint="@color/play_icon" />
        <ImageView
            
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_round"
            android:contentDescription="@string/cd_next"
            android:padding="9dp"
            android:src="@drawable/ic_next"
            android:tint="@color/icon" />
    </LinearLayout>
</LinearLayout>
